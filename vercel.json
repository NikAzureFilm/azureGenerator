{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/creation-mode-cad.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/creation-mode-mesh.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/creation-mode-cad.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/creation-mode-mesh.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/libraries/:path*",
      "destination": "/libraries/:path*"
    },
    {
      "source": "/Geist-Regular.ttf",
      "destination": "/Geist-Regular.ttf"
    },
    {
      "source": "/city.hdr",
      "destination": "/city.hdr"
    },
    {
      "source": "/:path*",
      "destination": "/_shell.html"
    }
  ],
  "trailingSlash": false
}
