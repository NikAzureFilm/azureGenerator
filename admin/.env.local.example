# ---------------------------------------------------------------------------
# Admin dashboard environment variables
# Copy to .env.local for local dev, and set the same in the Vercel project.
# NONE of these are exposed to the browser (no NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------

# Supabase project (same project as the main app)
SUPABASE_URL="https://<your-project-ref>.supabase.co"

# Anon/publishable key — used ONLY to validate admin login JWTs server-side.
SUPABASE_ANON_KEY="<your supabase anon key>"

# Service-role (secret) key — bypasses RLS to aggregate across all users.
# KEEP SECRET. Server-side only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<your supabase service_role key>"

# Comma-separated list of emails allowed into the dashboard.
ADMIN_EMAILS="<admin email addresses, comma-separated>"

# Stripe secret key for real revenue (actual cash collected + live MRR).
# Optional: if unset, the Stripe panels are hidden and DB-derived MRR is used.
STRIPE_SECRET_KEY="<your stripe secret key>"

# Optional: deep links on the Resources page. If unset, the Vercel links
# fall back to the generic Vercel dashboard.
VERCEL_TEAM_SLUG="<your vercel team slug>"
ADMIN_VERCEL_PROJECT="<vercel project name of this admin app>"
APP_VERCEL_PROJECT="<vercel project name of the customer app>"
